{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "types": ["react", "react-native"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "module": "esnext",
    "typeRoots": ["./node_modules/@types", "./declarations.d.ts"]
  },
  "exclude": ["node_modules", "babel.config.js"]
}